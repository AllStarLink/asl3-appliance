#!/usr/bin/bash -e
# postinst script for allmon3
#
# see: dh_installdeb(1)

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package
#
set -e

if [ -e /usr/share/apache2/apache2-maintscript-helper ] ; then
    . /usr/share/apache2/apache2-maintscript-helper
fi

do_configure() {

	#Apache Management

# Modules are only reloaded here (apache2_invoke restarts for each one
	# otherwise, which together with other packages' restarts can hit
	# systemd's start limit); apache2 is restarted below.
    if [ -e /usr/sbin/apache2 ]; then
        apache2_invoke enmod ssl reload || exit $?
		apache2_invoke enmod headers reload || exit $?
		apache2_invoke enmod rewrite reload || exit $?
		apache2_invoke enconf nocache || exit $?

		# The appliance's own sites replace Debian's default ones, the first
		# time they are enabled (a2query: 0 enabled, 32 disabled by the
		# admin). apache2_invoke cannot disable a site in configure. An older
		# appliance rewrote Debian's sites in place; they stay disabled as
		# they are.
		a2query -s 000-asl3-appliance > /dev/null 2>&1 && rc=0 || rc=$?
		if [ "$rc" -ne 0 ] && [ "$rc" -ne 32 ]; then
			a2dissite -q 000-default default-ssl || true
		fi
		apache2_invoke ensite 000-asl3-appliance || exit $?
		apache2_invoke ensite 000-asl3-appliance-ssl || exit $?
    fi

	# asl-web-ui: the appliance owns Apache's sites, so asl-web-ui only gives
	# the HTTPS site its Let's Encrypt certificate (through
	# /etc/asl-web-ui/apache-tls.conf). Generated rather than a conffile so
	# that removing the appliance hands the sites back to asl-web-ui.
	mkdir -p /etc/asl-web-ui/conf.d
	cat - > /etc/asl-web-ui/conf.d/50-asl3-appliance.ini <<EOF
; Written by asl3-appliance; changes made here are replaced. To override,
; put your settings in a later file, e.g. /etc/asl-web-ui/conf.d/90-local.ini
[https]
apache_vhosts = external
EOF
	# Move a certificate from asl-web-ui's own site into the appliance's.
	/usr/libexec/asl-web-ui/asl-web-ui-https-sync || \
		echo "WARNING: asl-web-ui-https-sync failed; check asl-web-ui's HTTPS page"

	# Check for Firewalld IPv6 reverse-path filter support, which is missing
	# from some kernels, including the Arduino UNO Q kernel.
	NFT_PROBE_TABLE="asl3_rpfilter_probe_$$"
	if ! nft --check --file - >/dev/null 2>&1 <<EOF
add table inet ${NFT_PROBE_TABLE}
add chain inet ${NFT_PROBE_TABLE} probe
add rule inet ${NFT_PROBE_TABLE} probe fib saddr type local accept
EOF
	then
		if grep -qE '^[[:space:]]*IPv6_rpfilter=no[[:space:]]*$' /etc/firewalld/firewalld.conf; then
			:
		elif grep -qE '^[[:space:]]*IPv6_rpfilter=' /etc/firewalld/firewalld.conf; then
			sed -i -E 's/^[[:space:]]*IPv6_rpfilter=.*/IPv6_rpfilter=no/' /etc/firewalld/firewalld.conf
			echo "NOTICE: disabled Firewalld IPv6 reverse-path filtering; unsupported by this kernel"
		else
			printf '\nIPv6_rpfilter=no\n' >> /etc/firewalld/firewalld.conf
			echo "NOTICE: disabled Firewalld IPv6 reverse-path filtering; unsupported by this kernel"
		fi
	fi

	# Services to start on boot
	deb-systemd-invoke enable apache2
	deb-systemd-invoke enable allmon3
	deb-systemd-invoke enable asterisk
	deb-systemd-invoke enable firewalld
	deb-systemd-invoke enable cockpit.socket
	deb-systemd-invoke restart apache2
	deb-systemd-invoke restart allmon3
	deb-systemd-invoke restart asterisk
	deb-systemd-invoke restart firewalld

	# Change default firewalld zone
	if [ "$(firewall-cmd --state)" = "running" ]; then
		deb-systemd-invoke reload firewalld
		firewall-cmd --set-default-zone=allstarlink
		firewall-cmd --zone=allstarlink --permanent --add-service=echolink
		firewall-cmd --zone=allstarlink --add-service=echolink
	else
		set +e
		firewall-offline-cmd --set-default-zone=allstarlink
		firewall-offline-cmd --zone=allstarlink --add-service=echolink
	fi

	set -e

	# Rewrite the motd
	cat - > /etc/motd <<EOF

            Welcome to AllStarLink v3

 * A CLI menu is accessible by typing 'sudo asl-menu'
 * The Asterisk CLI is accessible by typing 'sudo asterisk -rv'
 * An online manual is located at https://allstarlink.github.io
 * Package updates are obtained through the Cockpit web
   console or by typing 'sudo apt update && sudo apt upgrade -y'
 * This system uses firewalld. Ports are controlled in the
   Cockpit web console or by using the command:
     'sudo firewall-cmd -p PORT:TYPE'
 * For help, visit https://community.allstarlink.org

EOF

	# Customize /etc/os-release
	/usr/share/cockpit/branding/debian-AllStarLink/fix-os-release

	# Edit /etc/adduser.conf for asl-web-ui and ensure all gid=users
	# are added to asl-web-ui
	groupadd -fr asl-web-ui
	perl -pi -e 's/^#EXTRA_GROUPS="users"/EXTRA_GROUPS="users asl-web-ui"/g; s/^#ADD_EXTRA_GROUPS=0/ADD_EXTRA_GROUPS=1/g;' /etc/adduser.conf
	group_entry=$(getent group users) || exit 1
	gid=$(echo "$group_entry" | cut -d: -f3)
	{
		getent passwd | awk -F: -v gid="$gid" '$4 == gid {print $1}'
		echo "$group_entry" | cut -d: -f4 | tr ',' '\n'
	} | sort -u | while IFS= read -r user; do
		if [ -n "$user" ]; then
			usermod -aG asl-web-ui "$user"
		fi
	done

}

case "$1" in
    configure)
	do_configure
	;;
    triggered)
	/usr/share/cockpit/branding/debian-AllStarLink/fix-os-release
	;;
    abort-upgrade|abort-remove|abort-deconfigure)
	;;
    *)
	echo "postinst called with unknown argument \`$1'" >&2
	exit 1
	;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
