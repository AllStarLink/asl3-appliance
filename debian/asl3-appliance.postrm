#!/usr/bin/bash -e
# postrm script for asl3-appliance
#
# see: dh_installdeb(1)

set -e

if [ -e /usr/share/apache2/apache2-maintscript-helper ] ; then
    . /usr/share/apache2/apache2-maintscript-helper
fi

case "$1" in
	remove)
		# Hand Apache back to Debian's default sites, and asl-web-ui its own
		# HTTPS site (with its Let's Encrypt certificate, if any).
		# (The postinst disabled Debian's sites with a2dissite, so they count
		# as disabled by the admin and apache2_invoke would not enable them.)
		if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
			apache2_invoke dissite 000-asl3-appliance-ssl || true
			apache2_invoke dissite 000-asl3-appliance || true
			a2ensite -q 000-default default-ssl || true
		fi
		rm -f /etc/asl-web-ui/conf.d/50-asl3-appliance.ini
		if [ -x /usr/libexec/asl-web-ui/asl-web-ui-https-sync ]; then
			/usr/libexec/asl-web-ui/asl-web-ui-https-sync || true
		fi
	;;

	purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "postrm called with unknown argument \`$1'" >&2
		exit 1
	;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
