<?xml version="1.0" encoding="utf-8"?>
<zone>
  <short>AllStarLink</short>
  <description>Firewall rules for an AllStarLink appliance/system</description>
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
  <service name="echolink"/>
  <service name="http"/>
  <service name="https"/>
  <service name="cockpit"/>
  <service name="mdns"/>
  <service name="iax2"/>
  <service name="rtcm"/>
  <forward/>
  <!-- The fallback AP (src/fallback-ap) runs its own DHCP/DNS server on the
       host, scoped to its fixed subnet window (see AP_NETWORK in
       fallback-ap-watchdog.py). Neither is in the zone's plain <service>
       list above because that would accept DHCP/DNS server traffic from
       any source in the zone, not just fallback-AP clients. -->
  <rule family="ipv4">
    <service name="dhcp"/>
    <accept/>
  </rule>
  <rule family="ipv4">
    <source address="192.168.187.64/29"/>
    <service name="dns"/>
    <accept/>
  </rule>
</zone>

