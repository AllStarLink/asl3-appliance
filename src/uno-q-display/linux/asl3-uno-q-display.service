[Unit]
Description=ASL3 Arduino UNO Q node display
Requires=asl3-uno-q-app.service
After=asterisk.service asl3-uno-q-app.service

[Service]
Type=simple
User=asterisk
Group=asterisk
SupplementaryGroups=arduino-router
ExecStart=/usr/libexec/asl3/asl3-uno-q-display
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
