#!/usr/bin/bash
#
# asl-enable-pi-serial - make the GPIO 14/15 (header pins 8/10) UART usable
# by applications on a Raspberry Pi:
#
#   * no serial login console on the port
#   * UART hardware enabled
#   * on boards where Bluetooth owns the PL011 (Pi 3/4/400/Zero W/Zero 2 W/
#     CM4), Bluetooth is moved off it with dtoverlay=disable-bt so the full
#     UART lands on the header as /dev/ttyAMA0 (/dev/serial0)
#
# raspi-config (nonint mode) is used for the console and UART settings when it
# is installed. A minimal built-in fallback, derived from raspi-config, is used
# otherwise.
#
# Fallback code derived from https://github.com/RPi-Distro/raspi-config
# Copyright (c) 2012 Alex Bradbury <asb@asbradbury.org>
# Distributed under the MIT License
#
# Adapted for AllStarLink by Jason McCormick <jason@mfamily.org>
# Copyright (c) 2024 Jason McCormick <jason@mfamily.org>
# Distributed under the MIT License
#
# Options:
#   --keep-bt   leave Bluetooth on the PL011 (header gets the mini UART)
#   -q          only print on change/error
#
# Bluetooth handling can also be set persistently in
# /etc/default/asl-enable-pi-serial with BLUETOOTH=keep
#
# Exit status: 0 on success (prints "REBOOT REQUIRED" if anything changed),
# non-zero on failure.

set -o pipefail

BLUETOOTH=disable
QUIET=0

[ -r /etc/default/asl-enable-pi-serial ] && . /etc/default/asl-enable-pi-serial

for arg in "$@"; do
	case "$arg" in
		--keep-bt) BLUETOOTH=keep ;;
		-q) QUIET=1 ;;
		-h|--help)
			sed -n '2,32s/^# \{0,1\}//p' "$0"
			exit 0
			;;
		*)
			echo "Unknown option: $arg" >&2
			exit 2
			;;
	esac
done

msg() {
	[ "$QUIET" -eq 1 ] || echo "$@"
}

die() {
	echo "asl-enable-pi-serial: $*" >&2
	exit 1
}

[ "$(id -u)" -eq 0 ] || die "must be run as root"

if ! tr -d '\0' < /proc/device-tree/model 2>/dev/null | grep -q "Raspberry Pi"; then
	die "this does not appear to be a Raspberry Pi"
fi

if [ -e /boot/firmware/config.txt ]; then
	FIRMWARE=/firmware
else
	FIRMWARE=
fi
CONFIG=/boot${FIRMWARE}/config.txt

PREFIX=
if [ -e /proc/device-tree/chosen/os_prefix ]; then
	PREFIX="$(tr -d '\0' < /proc/device-tree/chosen/os_prefix)"
fi
CMDLINE="/boot${FIRMWARE}/${PREFIX}cmdline.txt"

[ -f "$CONFIG" ] || die "$CONFIG not found"
[ -f "$CMDLINE" ] || die "$CMDLINE not found"

# BCM2712 boards (Pi 5, Pi 500, CM5) have a dedicated Bluetooth UART
is_pifive() {
	grep -q "^Revision\s*:\s*[ 123][0-9a-fA-F][0-9a-fA-F]4[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$" /proc/cpuinfo
}

# Rewrite a file in place only if the filter succeeded, so a failure can
# never leave an empty or truncated config.txt/cmdline.txt behind
rewrite() {
	local file="$1"; shift
	local tmp
	tmp="$(mktemp "${file}.XXXXXX")" || return 1
	if "$@" < "$file" > "$tmp" && [ -s "$tmp" ]; then
		cat "$tmp" > "$file" && rm -f "$tmp"
	else
		rm -f "$tmp"
		return 1
	fi
}

# Append a line to config.txt under an explicit [all] section so it cannot
# end up inside a trailing [pi5]/[cm4]/etc. conditional block
append_all() {
	printf '\n[all]\n%s\n' "$1" >> "$CONFIG"
}

# The config.txt setting that turns on the header UART
if is_pifive; then
	UART_KEY=dtparam=uart0
	UART_VALUE=on
else
	UART_KEY=enable_uart
	UART_VALUE=1
fi

# If the UART setting is not in config.txt at all, add it under [all].
# raspi-config (and the fallback) then edit that line in place instead of
# appending it to whatever conditional section happens to be last.
seed_serial_hw() {
	grep -q -E "^[[:space:]]*#?[[:space:]]*${UART_KEY}=" "$CONFIG" \
		|| append_all "${UART_KEY}=${UART_VALUE}"
}

# Fallback used only when raspi-config is not installed
fallback_serial_hw() {
	rewrite "$CONFIG" awk -v key="$UART_KEY" -v value="$UART_VALUE" '
		$0 ~ "^[[:space:]]*#?[[:space:]]*" key "=" { print key "=" value; next }
		{ print }
	'
}

#
# Serial console off
#
if command -v raspi-config >/dev/null 2>&1; then
	USE_RASPI_CONFIG=1
else
	USE_RASPI_CONFIG=0
	msg "raspi-config not found; using built-in fallback"
fi

BACKUP_CONFIG="$(mktemp)" && BACKUP_CMDLINE="$(mktemp)" || die "mktemp failed"
trap 'rm -f "$BACKUP_CONFIG" "$BACKUP_CMDLINE"' EXIT
cp -p "$CONFIG" "$BACKUP_CONFIG" && cp -p "$CMDLINE" "$BACKUP_CMDLINE" \
	|| die "unable to snapshot boot configuration"

if [ "$USE_RASPI_CONFIG" -eq 1 ]; then
	raspi-config nonint do_serial_cons 1 || die "raspi-config do_serial_cons failed"
fi

# raspi-config only strips "console=ttyAMA0,N " and "console=serial0,N "
# (trailing space required); remove every UART console token wherever it is
rewrite "$CMDLINE" sed -E \
	-e 's/(^|[[:space:]])console=(serial[0-9]+|ttyAMA[0-9]+|ttyS[0-9]+)(,[^[:space:]]*)?//g' \
	-e 's/^[[:space:]]+//' \
	|| die "unable to update $CMDLINE"

#
# config.txt has no inline comments: "dtoverlay=disable-bt  # foo" is an
# invalid overlay name and "[all]  # foo" an unknown section filter, and the
# firmware silently ignores both. Strip trailing comments from section headers
# and from the settings this script manages.
#
rewrite "$CONFIG" sed -E \
	-e 's/^[[:space:]]*(\[[^]#]*\])[[:space:]]*#.*$/\1/' \
	-e 's/^[[:space:]]*((enable_uart|dtparam=uart0|dtoverlay=(pi3-)?(disable|miniuart)-bt)(=[^#[:space:]]*)?)[[:space:]]*#.*$/\1/' \
	|| die "unable to update $CONFIG"

#
# UART hardware on
#
seed_serial_hw || die "unable to update $CONFIG"
if [ "$USE_RASPI_CONFIG" -eq 1 ]; then
	raspi-config nonint do_serial_hw 0 || die "raspi-config do_serial_hw failed"
else
	fallback_serial_hw || die "unable to update $CONFIG"
fi

#
# Move Bluetooth off the PL011 (Pi 3/4 family)
#
if ! is_pifive && [ "$BLUETOOTH" != "keep" ]; then
	# An existing miniuart-bt also puts the PL011 on the header; respect it
	if ! grep -q -E '^[[:space:]]*dtoverlay=(pi3-)?(disable|miniuart)-bt[[:space:]]*$' "$CONFIG"; then
		append_all "dtoverlay=disable-bt"
		# Bluetooth attach service on older releases; absent on newer ones
		if systemctl list-unit-files hciuart.service >/dev/null 2>&1; then
			systemctl disable hciuart.service >/dev/null 2>&1 || true
		fi
	fi
fi

#
# Report
#
CHANGED=0
for pair in "$CONFIG:$BACKUP_CONFIG" "$CMDLINE:$BACKUP_CMDLINE"; do
	file="${pair%%:*}"
	orig="${pair#*:}"
	if ! cmp -s "$file" "$orig"; then
		CHANGED=1
		cp -p "$orig" "${file}.asl-serial.bak"
		msg "Updated ${file} (previous version saved as ${file}.asl-serial.bak)"
	fi
done

if [ "$CHANGED" -eq 1 ]; then
	echo
	echo "REBOOT REQUIRED for serial port changes to take effect"
	echo
else
	msg "Serial port already configured; no changes made"
fi

exit 0
